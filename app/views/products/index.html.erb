<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>

<% content_for :title, "商品一覧" %>

<header>
  <h1>商品一覧</h1>
  <%= link_to "カートを見る", cart_path(current_cart) %>
</header>

<table>
  <thead>
    <tr><th>商品名</th><th>価格</th><th>数量</th><th></th></tr>
  </thead>
  <tbody>
    <% @products.each do |product| %>
      <tr>
        <td><%= product.name %></td>
        <td><%= number_to_currency(product.price, unit: "¥", precision: 0) %></td>
        <td>
          <%= form_with url: cart_items_path, scope: :cart_item do |form| %>
            <%= form.hidden_field :product_id, value: product.id %>
            <%= form.number_field :quantity, value: 1, min: 1, aria: { label: "#{product.name}の数量" } %>
            <%= form.submit "カートに追加" %>
          <% end %>
        </td>
        <td><%= button_to "削除", product_path(product), method: :delete, data: { turbo_confirm: "#{product.name}を削除しますか？" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to "商品を登録", new_product_path %>
